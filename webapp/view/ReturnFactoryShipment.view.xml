<mvc:View
    controllerName="com.sut.bolgeyonetim.controller.ReturnFactoryShipment"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page
        title="İade Gönderimi"
        showNavButton="true"
        navButtonPress="onNavBack">
        <customHeader>
            <Toolbar>
                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press="onNavBack"/>
                <Title text="İade Gönderimi"/>
                <ToolbarSpacer/>
                <DatePicker
                    visible="false"
                    value="{filterModel>/selectedDate}"
                    displayFormat="dd.MM.yyyy"
                    valueFormat="yyyy-MM-dd"
                    change="onDateChange"
                    width="10rem"/>
                <Label
                    visible="false"
                    text="{sessionModel>/Login/WarehouseNum}"/>
            </Toolbar>
        </customHeader>
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <OverflowToolbar class="returnFactoryActionBar">
                    <core:Icon
                        src="sap-icon://shipping-status"
                        size="1.25rem"
                        color="#0854A0"/>
                    <Label text="Plaka"/>
                    <Select
                        width="10rem"
                        forceSelection="false"
                        selectedKey="{returnFactoryShipmentModel>/selectedVehicleKey}"
                        change="onVehicleChange"
                        items="{
                            path: 'returnFactoryShipmentModel>/vehicles',
                            templateShareable: false
                        }">
                        <core:Item
                            key="{returnFactoryShipmentModel>VehicleKey}"
                            text="{returnFactoryShipmentModel>VehicleText}"/>
                    </Select>
                    <Label text="&#220;Y"/>
                    <Select
                        width="10rem"
                        selectedKey="{returnFactoryShipmentModel>/selectedPlantKey}"
                        change="onPlantChange"
                        items="{
                            path: 'returnFactoryShipmentModel>/plants',
                            templateShareable: false
                        }">
                        <core:Item
                            key="{returnFactoryShipmentModel>PlantKey}"
                            text="{returnFactoryShipmentModel>PlantText}"/>
                    </Select>
                    <ToolbarSpacer/>
                    <Button
                        text="Tümünü Genişlet"
                        icon="sap-icon://expand-all"
                        type="Transparent"
                        enabled="{= ${returnFactoryShipmentModel>/totalItemCount} > 0 &amp;&amp; ${returnFactoryShipmentModel>/expandedItemCount} !== ${returnFactoryShipmentModel>/totalItemCount} }"
                        press="onExpandAllItemsPress">
                        <customData>
                            <core:CustomData key="expanded" value="true"/>
                        </customData>
                    </Button>
                    <Button
                        text="Tümünü Sıkıştır"
                        icon="sap-icon://collapse-all"
                        type="Transparent"
                        enabled="{= ${returnFactoryShipmentModel>/expandedItemCount} > 0 }"
                        press="onExpandAllItemsPress">
                        <customData>
                            <core:CustomData key="expanded" value="false"/>
                        </customData>
                    </Button>
                    <Button
                        text="Tümünü Tamamla"
                        icon="sap-icon://multiselect-all"
                        type="Transparent"
                        enabled="{= ${returnFactoryShipmentModel>/totalItemCount} > 0 &amp;&amp; ${returnFactoryShipmentModel>/expandedItemCount} === ${returnFactoryShipmentModel>/totalItemCount} }"
                        press="onConfirmAllCountsPress">
                        <customData>
                            <core:CustomData key="confirmed" value="true"/>
                        </customData>
                    </Button>
                    <Button
                        text="Temizle"
                        icon="sap-icon://clear-all"
                        type="Transparent"
                        enabled="{= ${returnFactoryShipmentModel>/confirmedItemCount} > 0 }"
                        press="onConfirmAllCountsPress">
                        <customData>
                            <core:CustomData key="confirmed" value="false"/>
                        </customData>
                    </Button>
                    <ObjectStatus
                        text="{returnFactoryShipmentModel>/confirmedItemCount}/{returnFactoryShipmentModel>/totalItemCount}"
                        state="None"/>
                    <Button
                        text="Gönderimi Onayla"
                        icon="sap-icon://accept"
                        type="Emphasized"
                        enabled="{returnFactoryShipmentModel>/canSubmit}"
                        press="onSubmitPress"/>
                </OverflowToolbar>

                <MessageStrip
                    text="{returnFactoryShipmentModel>/stockExceededMessage}"
                    type="Error"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{returnFactoryShipmentModel>/hasStockExceeded}"
                    class="sapUiSmallMarginTop"/>

                <Panel
                    expandable="false"
                    class="sapUiSmallMarginTop returnFactoryProductPanel">
                    <headerToolbar>
                        <OverflowToolbar>
                            <core:Icon
                                src="sap-icon://product"
                                size="1.2rem"/>
                            <Title text="Ürünler" level="H4"/>
                            <ObjectNumber number="{returnFactoryShipmentModel>/totalItemCount}"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <List
                            items="{
                                path: 'returnFactoryShipmentModel>/items',
                                templateShareable: false
                            }"
                            growing="true"
                            growingThreshold="30"
                            showSeparators="None"
                            noDataText="Seçilen tarih ve depo için iade depo stoğu bulunamadı"
                            class="returnFactoryCardList">
                            <items>
                                <CustomListItem
                                    highlight="{returnFactoryShipmentModel>RowHighlight}"
                                    type="Active"
                                    press="onFactoryItemTogglePress"
                                    tooltip="Ürün detaylarını açmak veya kapatmak için tıklayın">
                                    <VBox class="returnFactoryItemCard sapUiSmallMargin">
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceBetween"
                                            wrap="NoWrap"
                                            class="returnFactoryItemHeader">
                                            <HBox alignItems="Center" class="returnFactoryMaterialBlock sapUiTinyMarginEnd">
                                                <core:Icon
                                                    src="{= ${returnFactoryShipmentModel>_expanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-down' }"
                                                    size="1rem"
                                                    class="sapUiTinyMarginEnd"/>
                                                <ObjectIdentifier
                                                    title="{returnFactoryShipmentModel>Maktx}"
                                                    text="{returnFactoryShipmentModel>MaterialDisplayCode}"
                                                    class="returnFactoryMaterial"/>
                                            </HBox>
                                            <HBox alignItems="Center" wrap="NoWrap" class="returnFactoryHeaderMetrics">
                                                <VBox class="returnFactoryStockMetric sapUiTinyMarginEnd">
                                                    <Label text="Stok"/>
                                                    <ObjectNumber
                                                        number="{returnFactoryShipmentModel>SapStock}"
                                                        unit="{returnFactoryShipmentModel>Meins}"/>
                                                </VBox>
                                                <VBox class="returnFactoryStockMetric sapUiTinyMarginEnd">
                                                    <Label text="Sayım"/>
                                                    <ObjectNumber
                                                        number="{returnFactoryShipmentModel>MengeSayim}"
                                                        unit="{returnFactoryShipmentModel>Meins}"
                                                        state="{returnFactoryShipmentModel>RowState}"/>
                                                </VBox>
                                                <CheckBox
                                                    text=""
                                                    selected="{returnFactoryShipmentModel>_countConfirmed}"
                                                    enabled="true"
                                                    tooltip="Bu kalemin fiziksel sayımı tamamlandı"
                                                    select="onCountConfirmed"/>
                                            </HBox>
                                        </HBox>

                                        <VBox visible="{returnFactoryShipmentModel>_expanded}">
                                            <Button
                                                text="Ekstra &#304;ade Nedeni Giri&#351;i"
                                                icon="sap-icon://add"
                                                type="Transparent"
                                                enabled="{= !${returnFactoryShipmentModel>_countConfirmed} }"
                                                press="onExtraReturnReasonPress"
                                                class="sapUiTinyMarginTop sapUiTinyMarginBottom returnFactoryExtraReasonButton"/>

                                            <FlexBox wrap="Wrap" class="returnFactoryCategoryGrid">
                                            <VBox class="returnFactoryQuantityField">
                                                <Label text="Üretim Hatalı"/>
                                                <Input
                                                    value="{returnFactoryShipmentModel>MengeUretimHatali}"
                                                    type="Number"
                                                    textAlign="End"
                                                    class="returnFactoryQuantityInput"
                                                    editable="{= !${returnFactoryShipmentModel>_countConfirmed} }"
                                                    change="onCountChange"/>
                                            </VBox>
                                            <VBox class="returnFactoryQuantityField">
                                                <Label text="Fabrika Lojistik"/>
                                                <Input
                                                    value="{returnFactoryShipmentModel>MengeFabrikaLojistik}"
                                                    type="Number"
                                                    textAlign="End"
                                                    class="returnFactoryQuantityInput"
                                                    editable="{= !${returnFactoryShipmentModel>_countConfirmed} }"
                                                    change="onCountChange"/>
                                            </VBox>
                                            <VBox class="returnFactorySalesFireGroup">
                                                <Title text="Satış Firesi" level="H6"/>
                                                <FlexBox wrap="Wrap">
                                                    <VBox class="returnFactoryQuantityField returnFactorySalesFireField">
                                                        <Label text="Katı"/>
                                                        <Input
                                                            value="{returnFactoryShipmentModel>MengeSatisFireKati}"
                                                            type="Number"
                                                            textAlign="End"
                                                            class="returnFactoryQuantityInput"
                                                            editable="{= !${returnFactoryShipmentModel>_countConfirmed} }"
                                                            change="onCountChange"/>
                                                    </VBox>
                                                    <VBox class="returnFactoryQuantityField returnFactorySalesFireField">
                                                        <Label text="Sıvı"/>
                                                        <Input
                                                            value="{returnFactoryShipmentModel>MengeSatisFireSivi}"
                                                            type="Number"
                                                            textAlign="End"
                                                            class="returnFactoryQuantityInput"
                                                            editable="{= !${returnFactoryShipmentModel>_countConfirmed} }"
                                                            change="onCountChange"/>
                                                    </VBox>
                                                    <VBox class="returnFactoryQuantityField returnFactorySalesFireField">
                                                        <Label text="UHT"/>
                                                        <Input
                                                            value="{returnFactoryShipmentModel>MengeSatisFireUht}"
                                                            type="Number"
                                                            textAlign="End"
                                                            class="returnFactoryQuantityInput"
                                                            editable="{= !${returnFactoryShipmentModel>_countConfirmed} }"
                                                            change="onCountChange"/>
                                                    </VBox>
                                                    <VBox class="returnFactoryQuantityField returnFactorySalesFireField">
                                                        <Label text="Cam"/>
                                                        <Input
                                                            value="{returnFactoryShipmentModel>MengeSatisFireCam}"
                                                            type="Number"
                                                            textAlign="End"
                                                            class="returnFactoryQuantityInput"
                                                            editable="{= !${returnFactoryShipmentModel>_countConfirmed} }"
                                                            change="onCountChange"/>
                                                    </VBox>
                                                </FlexBox>
                                            </VBox>
                                            </FlexBox>
                                        </VBox>
                                    </VBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
