<mvc:View
    controllerName="com.sut.bolgeyonetim.controller.ReturnFactoryShipment"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        title="İade Gönderimi"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <customHeader>
            <Toolbar>
                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press="onNavBack"
                />
                <Title text="İade Gönderimi" />
                <ToolbarSpacer />
                    <Button
                        text="{i18n>factoryShipmentSendForApproval}"
                        icon="sap-icon://accept"
                        type="Emphasized"
                        busy="{returnFactoryShipmentModel>/isSubmitting}"
                        busyIndicatorDelay="0"
                        enabled="{= ${returnFactoryShipmentModel>/canSubmit} &amp;&amp; !${returnFactoryShipmentModel>/isSubmitting} &amp;&amp; !${returnFactoryShipmentModel>/availabilityBusy} }"
                        press="onSubmitPress"
                    />
                    <Button
                        visible="true"
                        text="{i18n>factoryShipmentOpenApproval}"
                        icon="sap-icon://approvals"
                        type="Transparent"
                        press="onApprovalScreenPress"
                    />
                <DatePicker
                    visible="false"
                    value="{filterModel>/selectedDate}"
                    displayFormat="dd.MM.yyyy"
                    valueFormat="yyyy-MM-dd"
                    change="onDateChange"
                    width="10rem"
                />
                <Label
                    visible="false"
                    text="{sessionModel>/Login/WarehouseNum}"
                />
            </Toolbar>
        </customHeader>
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <OverflowToolbar
                    busy="{= ${returnFactoryShipmentModel>/isSubmitting} || ${returnFactoryShipmentModel>/availabilityBusy} }"
                    busyIndicatorDelay="0"
                    class="returnFactoryActionBar"
                >
                    <core:Icon
                        src="sap-icon://shipping-status"
                        size="1.25rem"
                        color="#0854A0"
                    />
                    <Label text="Plaka" />
                    <ComboBox
                        width="10rem"
                        enabled="{returnFactoryShipmentModel>/createAllowed}"
                        forceSelection="false"
                        value="{returnFactoryShipmentModel>/vehicleInput}"
                        selectedKey="{returnFactoryShipmentModel>/selectedVehicleKey}"
                        placeholder="{i18n>factoryShipmentPlatePlaceholder}"
                        change="onVehicleChange"
                        items="{
                            path: 'returnFactoryShipmentModel>/vehicles',
                            templateShareable: false
                        }"
                    >
                        <core:Item
                            key="{returnFactoryShipmentModel>VehicleKey}"
                            text="{returnFactoryShipmentModel>VehicleText}"
                        />
                    </ComboBox>
                    <Label text="&#220;Y" />
                    <Select
                        width="10rem"
                        enabled="{returnFactoryShipmentModel>/createAllowed}"
                        selectedKey="{returnFactoryShipmentModel>/selectedPlantKey}"
                        change="onPlantChange"
                        items="{
                            path: 'returnFactoryShipmentModel>/plants',
                            templateShareable: false
                        }"
                    >
                        <core:Item
                            key="{returnFactoryShipmentModel>PlantKey}"
                            text="{returnFactoryShipmentModel>PlantText}"
                        />
                    </Select>
                    <ToolbarSpacer />

                    <Button
                        text="Tümünü Genişlet"
                        icon="sap-icon://expand-all"
                        type="Transparent"
                        enabled="{= (${returnFactoryShipmentModel>/selectedCategoryFilter} === 'ALL' || ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER') &amp;&amp; (${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER' ? ${returnFactoryShipmentModel>/visibleItemCount} : ${returnFactoryShipmentModel>/totalItemCount}) > 0 &amp;&amp; ${returnFactoryShipmentModel>/expandedItemCount} !== (${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER' ? ${returnFactoryShipmentModel>/visibleItemCount} : ${returnFactoryShipmentModel>/totalItemCount}) }"
                        press="onExpandAllItemsPress"
                    >
                        <customData>
                            <core:CustomData
                                key="expanded"
                                value="true"
                            />
                        </customData>
                    </Button>
                    <Button
                        text="Tümünü Sıkıştır"
                        icon="sap-icon://collapse-all"
                        type="Transparent"
                        enabled="{= (${returnFactoryShipmentModel>/selectedCategoryFilter} === 'ALL' || ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER') &amp;&amp; ${returnFactoryShipmentModel>/expandedItemCount} > 0 }"
                        press="onExpandAllItemsPress"
                    >
                        <customData>
                            <core:CustomData
                                key="expanded"
                                value="false"
                            />
                        </customData>
                    </Button>
                    <Button
                        text="Tümünü Tamamla"
                        icon="sap-icon://multiselect-all"
                        type="Transparent"
                        enabled="{= ${returnFactoryShipmentModel>/confirmationTargetCount} > 0 &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                        press="onConfirmAllCountsPress"
                    >
                        <customData>
                            <core:CustomData
                                key="confirmed"
                                value="true"
                            />
                        </customData>
                    </Button>
                    <Button
                        text="Temizle"
                        icon="sap-icon://clear-all"
                        type="Transparent"
                        enabled="{= ${returnFactoryShipmentModel>/confirmedItemCount} > 0 &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                        press="onConfirmAllCountsPress"
                    >
                        <customData>
                            <core:CustomData
                                key="confirmed"
                                value="false"
                            />
                        </customData>
                    </Button>
                    <ObjectStatus
                        text="{returnFactoryShipmentModel>/confirmedItemCount}/{returnFactoryShipmentModel>/confirmationTargetCount}"
                        state="None"
                    />

                </OverflowToolbar>

                <MessageStrip
                    text="{returnFactoryShipmentModel>/creationBlockMessage}"
                    type="Warning"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{returnFactoryShipmentModel>/creationBlocked}"
                    class="sapUiSmallMarginTop"
                />

                <MessageStrip
                    text="{returnFactoryShipmentModel>/stockExceededMessage}"
                    type="Error"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{returnFactoryShipmentModel>/hasStockExceeded}"
                    class="sapUiSmallMarginTop"
                />

                <Panel
                    expandable="false"
                    class="sapUiSmallMarginTop returnFactoryProductPanel"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <core:Icon
                                src="sap-icon://product"
                                size="1.2rem"
                            />
                            <Title
                                text="Ürünler"
                                level="H4"
                            />
                            <ObjectNumber
                                number="{returnFactoryShipmentModel>/totalItemCount}"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="returnFactoryFilterBar">
                            <HBox
                                alignItems="Center"
                                justifyContent="SpaceBetween"
                                wrap="Wrap"
                                class="returnFactoryFilterHeading"
                            >
                                <HBox alignItems="Center">
                                    <core:Icon
                                        src="sap-icon://filter"
                                        size="1rem"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <Label
                                        text="&#220;r&#252;nleri kategoriye g&#246;re filtrele"
                                    />
                                </HBox>
                                <ObjectStatus
                                    text="{= ${returnFactoryShipmentModel>/visibleItemCount} + ' / ' + ${returnFactoryShipmentModel>/totalItemCount} + ' &#252;r&#252;n' }"
                                    state="None"
                                />
                            </HBox>
                            <SearchField
                                value="{returnFactoryShipmentModel>/productSearchQuery}"
                                placeholder="&#220;r&#252;n kodu veya a&#231;&#305;klamas&#305; ara"
                                liveChange="onProductSearch"
                                search="onProductSearch"
                                width="100%"
                                class="returnFactoryProductSearch"
                            />
                            <FlexBox
                                wrap="NoWrap"
                                items="{
                                    path: 'returnFactoryShipmentModel>/categoryFilters',
                                    templateShareable: false
                                }"
                                class="returnFactoryFilterOptions"
                            >
                                <items>
                                    <ToggleButton
                                        text="{returnFactoryShipmentModel>text}"
                                        pressed="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} === ${returnFactoryShipmentModel>key} }"
                                        enabled="{= ${returnFactoryShipmentModel>key} === 'ALL' || ${returnFactoryShipmentModel>count} > 0 }"
                                        press="onCategoryFilterPress"
                                        class="returnFactoryFilterButton"
                                    />
                                </items>
                            </FlexBox>
                            <FlexBox
                                visible="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'SATIS_FIRESI' }"
                                wrap="NoWrap"
                                items="{
                                    path: 'returnFactoryShipmentModel>/salesFireFilters',
                                    templateShareable: false
                                }"
                                class="returnFactoryFilterOptions returnFactorySalesFireFilters"
                            >
                                <items>
                                    <ToggleButton
                                        text="{returnFactoryShipmentModel>text}"
                                        pressed="{= ${returnFactoryShipmentModel>/selectedSalesFireFilter} === ${returnFactoryShipmentModel>key} }"
                                        enabled="{= ${returnFactoryShipmentModel>key} === 'SATIS_FIRESI_ALL' || ${returnFactoryShipmentModel>count} > 0 }"
                                        press="onSalesFireFilterPress"
                                        class="returnFactoryFilterButton"
                                    />
                                </items>
                            </FlexBox>
                            <HBox width="100%" justifyContent="End" class="returnFactoryCompletionFilters">
                                <ToggleButton
                                    text="{= 'Sayılmayan (' + ${returnFactoryShipmentModel>/uncountedItemCount} + ')' }"
                                    tooltip="Sayılmayan ürünleri göster; tekrar basarak genel görünüme dön"
                                    pressed="{= ${returnFactoryShipmentModel>/selectedCompletionFilter} === 'UNCOUNTED' }"
                                    press="onCompletionFilterPress"
                                    class="returnFactoryUncountedToggle"/>
                            </HBox>
                        </VBox>
                        <List
                            id="returnFactoryProductList"
                            items="{
                                path: 'returnFactoryShipmentModel>/items',
                                templateShareable: false
                            }"
                            growing="true"
                            growingThreshold="30"
                            showSeparators="None"
                            noDataText="{returnFactoryShipmentModel>/filterNoDataText}"
                            class="returnFactoryCardList"
                        >
                            <items>
                                <CustomListItem
                                    highlight="{returnFactoryShipmentModel>RowHighlight}"
                                    type="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'ALL' || ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER' ? 'Active' : 'Inactive' }"
                                    press="onFactoryItemTogglePress"
                                    tooltip="Ürün detaylarını açmak veya kapatmak için tıklayın"
                                >
                                    <VBox
                                        class="returnFactoryItemCard sapUiSmallMargin"
                                    >
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceBetween"
                                            wrap="NoWrap"
                                            class="returnFactoryItemHeader"
                                        >
                                            <HBox
                                                alignItems="Center"
                                                class="returnFactoryMaterialBlock sapUiTinyMarginEnd"
                                            >
                                                <core:Icon
                                                    visible="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'ALL' || ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER' }"
                                                    src="{= ${returnFactoryShipmentModel>_expanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-down' }"
                                                    size="1rem"
                                                    class="sapUiTinyMarginEnd"
                                                />
                                                <ObjectIdentifier
                                                    title="{returnFactoryShipmentModel>Maktx}"
                                                    text="{returnFactoryShipmentModel>MaterialDisplayCode}"
                                                    class="returnFactoryMaterial"
                                                />
                                            </HBox>
                                            <HBox
                                                alignItems="Center"
                                                wrap="NoWrap"
                                                class="returnFactoryHeaderMetrics"
                                            >
                                                <VBox
                                                    visible="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'ALL' || ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER' }"
                                                    class="returnFactoryStockMetric sapUiTinyMarginEnd"
                                                >
                                                    <Label text="Stok" />
                                                    <ObjectNumber
                                                        number="{returnFactoryShipmentModel>SapStock}"
                                                        unit="{returnFactoryShipmentModel>Meins}"
                                                    />
                                                </VBox>
                                                <VBox
                                                    class="returnFactoryStockMetric returnFactoryCountMetric"
                                                >
                                                    <Label text="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER' ? 'Diğer' : 'Sayım' }" />
                                                    <HBox
                                                        alignItems="Center"
                                                        wrap="NoWrap"
                                                        class="returnFactoryCountRow"
                                                    >
                                                        <ObjectNumber
                                                            visible="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'ALL' || ${returnFactoryShipmentModel>/selectedCategoryFilter} === 'DIGER' }"
                                                            number="{returnFactoryShipmentModel>SelectedCategoryCount}"
                                                            unit="{returnFactoryShipmentModel>Meins}"
                                                            state="{returnFactoryShipmentModel>RowState}"
                                                        />
                                                        <HBox
                                                            visible="{= ${returnFactoryShipmentModel>/selectedCategoryFilter} !== 'ALL' &amp;&amp; ${returnFactoryShipmentModel>/selectedCategoryFilter} !== 'DIGER' }"
                                                            alignItems="Center">
                                                            <Input
                                                                value="{returnFactoryShipmentModel>SelectedCategoryCount}"
                                                                type="Number"
                                                                width="5rem"
                                                                textAlign="End"
                                                                editable="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                                change="onFilteredCountChange"
                                                                class="returnFactoryQuantityInput sapUiTinyMarginEnd"/>
                                                            <Text text="{returnFactoryShipmentModel>Meins}"/>
                                                        </HBox>
                                                        <CheckBox
                                                            text=""
                                                            selected="{returnFactoryShipmentModel>_countConfirmed}"
                                                            enabled="{returnFactoryShipmentModel>/createAllowed}"
                                                            tooltip="Bu kalemin fiziksel sayımı tamamlandı"
                                                            select="onCountConfirmed"
                                                            class="returnFactoryConfirmCheck"/>
                                                    </HBox>
                                                </VBox>
                                            </HBox>
                                        </HBox>

                                        <VBox
                                            visible="{returnFactoryShipmentModel>_expanded}"
                                        >
                                            <Button
                                                text="Ekstra &#304;ade Nedeni Giri&#351;i"
                                                icon="sap-icon://add"
                                                type="Transparent"
                                                enabled="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                press="onExtraReturnReasonPress"
                                                class="sapUiTinyMarginTop sapUiTinyMarginBottom returnFactoryExtraReasonButton"
                                            />

                                            <FlexBox
                                                wrap="Wrap"
                                                class="returnFactoryCategoryGrid"
                                            >
                                                <VBox
                                                    class="returnFactoryQuantityField"
                                                >
                                                    <Label
                                                        text="Üretim Hatalı"
                                                    />
                                                    <Input
                                                        value="{returnFactoryShipmentModel>MengeUretimHatali}"
                                                        type="Number"
                                                        textAlign="End"
                                                        class="returnFactoryQuantityInput"
                                                        editable="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                        change="onCountChange"
                                                    />
                                                </VBox>
                                                <VBox
                                                    class="returnFactoryQuantityField"
                                                >
                                                    <Label
                                                        text="Fabrika Lojistik"
                                                    />
                                                    <Input
                                                        value="{returnFactoryShipmentModel>MengeFabrikaLojistik}"
                                                        type="Number"
                                                        textAlign="End"
                                                        class="returnFactoryQuantityInput"
                                                        editable="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                        change="onCountChange"
                                                    />
                                                </VBox>
                                                <VBox
                                                    class="returnFactorySalesFireGroup"
                                                >
                                                    <Title
                                                        text="Satış Firesi"
                                                        level="H6"
                                                    />
                                                    <FlexBox wrap="Wrap">
                                                        <VBox
                                                            class="returnFactoryQuantityField returnFactorySalesFireField"
                                                        >
                                                            <Label
                                                                text="Katı"
                                                            />
                                                            <Input
                                                                value="{returnFactoryShipmentModel>MengeSatisFireKati}"
                                                                type="Number"
                                                                textAlign="End"
                                                                class="returnFactoryQuantityInput"
                                                                editable="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                                change="onCountChange"
                                                            />
                                                        </VBox>
                                                        <VBox
                                                            class="returnFactoryQuantityField returnFactorySalesFireField"
                                                        >
                                                            <Label
                                                                text="Sıvı"
                                                            />
                                                            <Input
                                                                value="{returnFactoryShipmentModel>MengeSatisFireSivi}"
                                                                type="Number"
                                                                textAlign="End"
                                                                class="returnFactoryQuantityInput"
                                                                editable="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                                change="onCountChange"
                                                            />
                                                        </VBox>
                                                        <VBox
                                                            class="returnFactoryQuantityField returnFactorySalesFireField"
                                                        >
                                                            <Label text="UHT" />
                                                            <Input
                                                                value="{returnFactoryShipmentModel>MengeSatisFireUht}"
                                                                type="Number"
                                                                textAlign="End"
                                                                class="returnFactoryQuantityInput"
                                                                editable="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                                change="onCountChange"
                                                            />
                                                        </VBox>
                                                        <VBox
                                                            class="returnFactoryQuantityField returnFactorySalesFireField"
                                                        >
                                                            <Label text="Cam" />
                                                            <Input
                                                                value="{returnFactoryShipmentModel>MengeSatisFireCam}"
                                                                type="Number"
                                                                textAlign="End"
                                                                class="returnFactoryQuantityInput"
                                                                editable="{= !${returnFactoryShipmentModel>_countConfirmed} &amp;&amp; ${returnFactoryShipmentModel>/createAllowed} }"
                                                                change="onCountChange"
                                                            />
                                                        </VBox>
                                                    </FlexBox>
                                                </VBox>
                                            </FlexBox>
                                        </VBox>
                                    </VBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
