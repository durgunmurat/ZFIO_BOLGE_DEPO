<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="idExtraReturnReasonDialog"
        title="Ekstra &#304;ade Nedeni Giri&#351;i"
        contentWidth="28rem"
        stretch="{device>/isPhone}"
        afterOpen="onExtraReturnReasonAfterOpen"
        class="returnFactoryExtraReasonDialog">
        <content>
            <VBox class="returnFactoryExtraReasonContent">
                <HBox
                    alignItems="Center"
                    class="returnFactoryExtraReasonMaterial">
                    <core:Icon
                        src="sap-icon://product"
                        size="1.25rem"
                        class="sapUiSmallMarginEnd"/>
                    <ObjectIdentifier
                        title="{returnFactoryShipmentModel>/extraReturnDialog/materialText}"/>
                </HBox>
                <VBox class="returnFactoryExtraReasonGroup">
                    <HBox
                        alignItems="Center"
                        class="returnFactoryExtraReasonHeading">
                        <core:Icon
                            src="sap-icon://undo"
                            size="1rem"
                            class="sapUiTinyMarginEnd"/>
                        <Title
                            text="Toplat&#305;lan &#220;r&#252;n &#304;ade"
                            level="H5"/>
                    </HBox>
                    <Text
                        text="Toplat&#305;lan &#252;r&#252;n miktar&#305;n&#305; girin."
                        class="returnFactoryExtraReasonHint"/>
                    <Label
                        text="Miktar"
                        labelFor="idExtraReturnReasonQuantity"
                        class="returnFactoryExtraReasonLabel"/>
                    <Input
                        id="idExtraReturnReasonQuantity"
                        value="{returnFactoryShipmentModel>/extraReturnDialog/value}"
                        type="Number"
                        textAlign="End"
                        class="returnFactoryQuantityInput"/>
                </VBox>
            </VBox>
        </content>
        <buttons>
            <Button
                text="Kaydet"
                type="Emphasized"
                press="onExtraReturnReasonSave"/>
            <Button
                text="&#304;ptal"
                type="Transparent"
                press="onExtraReturnReasonCancel"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
