<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="idExtraReturnReasonDialog"
        title="Ekstra &#304;ade Nedeni Giri&#351;i"
        contentWidth="28rem"
        stretch="{device>/isPhone}"
        afterOpen="onExtraReturnReasonAfterOpen">
        <content>
            <VBox class="sapUiSmallMargin">
                <ObjectIdentifier
                    title="{returnFactoryShipmentModel>/extraReturnDialog/materialText}"
                    class="sapUiSmallMarginBottom"/>
                <VBox class="returnFactoryExtraReasonGroup">
                    <Label text="Toplat&#305;lan &#220;r&#252;n &#304;ade"/>
                    <Input
                        value="{returnFactoryShipmentModel>/extraReturnDialog/value}"
                        type="Number"
                        textAlign="End"
                        class="returnFactoryQuantityInput"/>
                </VBox>
            </VBox>
        </content>
        <buttons>
            <Button
                text="Kaydet"
                type="Emphasized"
                press="onExtraReturnReasonSave"/>
            <Button
                text="&#304;ptal"
                type="Transparent"
                press="onExtraReturnReasonCancel"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
