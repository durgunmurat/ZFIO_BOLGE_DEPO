<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="idReturnDepositAddDialog"
        title="Depozito Ekle"
        contentWidth="95%"
        contentHeight="600px"
        stretch="{device>/isPhone}"
        verticalScrolling="true"
        horizontalScrolling="false"
        class="returnDepositAddDialog">
        <content>
            <VBox class="sapUiSmallMargin returnDepositAddContent">
                <MessageStrip
                    text="{= ${returnDepositAddModel>/isMD} ? 'Sayıma eklemek istediğiniz depozito malzemelerinin miktarını girin.' : 'Eklemek istediğiniz depozito malzemelerinin miktarını girin. Son ZDAI siparişinden gelen malzemeler değiştirilemez.' }"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                <SearchField
                    id="idReturnDepositSearchField"
                    width="100%"
                    placeholder="Ürün adı veya ürün kodu ara"
                    liveChange="onReturnDepositSearch"
                    search="onReturnDepositSearch"
                    class="sapUiSmallMarginBottom"/>
                <Table
                    id="idReturnDepositAddTable"
                    items="{
                        path: 'returnDepositAddModel>/items',
                        templateShareable: false
                    }"
                    growing="false"
                    sticky="ColumnHeaders"
                    noDataText="Depozito malzemesi bulunamadı"
                    fixedLayout="true"
                    class="returnDepositAddTable">
                    <columns>
                        <Column width="65%">
                            <Text text="MALZEME"/>
                        </Column>
                        <Column width="35%" hAlign="Center">
                            <Text text="MİKTAR"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            highlight="{= ${returnDepositAddModel>IsExisting} ? 'None' : 'Information' }">
                            <cells>
                                <ObjectIdentifier
                                    title="{returnDepositAddModel>Maktx}"
                                    text="{returnDepositAddModel>MaterialDisplayCode}"/>
                                <StepInput
                                    value="{returnDepositAddModel>Quantity}"
                                    min="0"
                                    max="999"
                                    step="1"
                                    width="100%"
                                    displayValuePrecision="0"
                                    textAlign="Center"
                                    class="returnDepositQuantityStepInput"
                                    enabled="{= !${returnDepositAddModel>IsExisting} }"
                                    change="onReturnDepositQuantityChange"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <buttons>
            <Button
                text="Ekle"
                type="Emphasized"
                press="onReturnDepositAddSave"/>
            <Button
                text="İptal"
                type="Transparent"
                press="onReturnDepositAddCancel"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
